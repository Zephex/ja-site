# Local deploy settings — copy this file to .deploy.env and edit.
# .deploy.env is gitignored and never uploaded by deploy.sh.

# SSH target: an alias from ~/.ssh/config, or user@host.
JA_SSH=your-server

# Optional overrides
# JA_REMOTE_DIR=/opt/ja-site
# JA_PORT=8080
# JA_BASE_URL=https://invites.example.com
# SKIP_CADDY=1
