[Unit]
Description=invites.example.com invite pages
After=network.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/srv/ja-site
Environment=JA_HOST=127.0.0.1
Environment=JA_PORT=8080
Environment=JA_BASE_URL=https://invites.example.com
ExecStart=/usr/bin/python3 -m app.server
Restart=on-failure
RestartSec=3

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/ja-site/storage
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
